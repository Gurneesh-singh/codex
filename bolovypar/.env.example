# Copy relevant values into mobile/.env and backend/.env.
# Expo publishes EXPO_PUBLIC_* values in the app bundle. Use only public values there.

# mobile/.env
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Set true only for a USB-connected Android test with `adb reverse tcp:4000 tcp:4000`.
# EXPO_PUBLIC_ANDROID_USB_FORWARDING=true
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# backend/.env
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Add the laptop's LAN origin when testing the web app from a phone on the same network.
CORS_ORIGIN=http://localhost:8081,http://192.168.1.10:8081
# Use the Supabase Connect panel's session pooler URI for a long-lived API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# The backend verifies the Supabase pooler's certificate against its bundled root CA.
DATABASE_SSL=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Sarvam is the fallback if Groq Whisper transcription fails.
SARVAM_API_KEY=YOUR_SARVAM_KEY
GROQ_API_KEY=YOUR_GROQ_KEY
# Optional: a Groq model available to your account; default is openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b
# Optional self-hosted AI4Bharat ASR evaluation endpoint. Never expose it to the mobile app.
# AI4BHARAT_ASR_URL=https://PRIVATE_ASR_HOST/transcribe
# AI4BHARAT_ASR_TOKEN=YOUR_PRIVATE_SERVICE_TOKEN
